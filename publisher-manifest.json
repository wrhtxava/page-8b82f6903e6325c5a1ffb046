          "body": "<style>\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{font-family:\"Songti SC\",\"Noto Serif SC\",\"Source Han Serif SC\",\"STSong\",serif;background:#f5efe3;color:#3a2326;line-height:1.7;-webkit-font-smoothing:antialiased;word-break:break-word}\na{color:#7a1a2b;text-decoration:none;border-bottom:1px dashed rgba(122,26,43,.4)}\na:hover{border-bottom-style:solid}\n.wrap{max-width:980px;margin:0 auto;padding:0 22px}\n\n/* 导航跳转条（无固定导航） */\n.jumpnav{padding:14px 22px;border-bottom:1px solid rgba(122,26,43,.18);background:#faf5ea;display:flex;flex-wrap:wrap;gap:14px;align-items:center;font-size:13px;letter-spacing:.05em}\n.jumpnav .dot{width:8px;height:8px;background:#7a1a2b;border-radius:50%;display:inline-block}\n.jumpnav a{color:#5a242c;border-bottom:none;padding:4px 0}\n.jumpnav a:hover{color:#3a0d12}\n.jumpnav .spacer{flex:1}\n\n/* HERO 海报式 */\n.hero{position:relative;padding:90px 22px 70px;background:linear-gradient(180deg,#faf5ea 0%,#f0e4d0 100%);border-bottom:1px solid rgba(122,26,43,.18);overflow:hidden}\n.hero::before{content:\"\";position:absolute;top:30px;left:0;right:0;height:2px;background:#7a1a2b;opacity:.4}\n.hero::after{content:\"\";position:absolute;bottom:30px;left:0;right:0;height:1px;background:#7a1a2b;opacity:.25}\n.hero-inner{max-width:980px;margin:0 auto;position:relative}\n.hero .eyebrow{font-family:\"Optima\",\"PingFang SC\",sans-serif;letter-spacing:.5em;font-size:11px;color:#7a1a2b;text-transform:uppercase;margin-bottom:26px}\n.hero h1{font-size:clamp(48px,13vw,140px);font-weight:900;line-height:.92;letter-spacing:-.02em;color:#3a0d12;margin-bottom:18px;font-feature-settings:\"palt\"}\n.hero h1 small{display:block;font-size:clamp(18px,3vw,28px);font-weight:400;letter-spacing:.4em;color:#7a1a2b;margin-top:14px}\n.hero .tagline{max-width:560px;font-size:15px;color:#5a242c;margin-top:24px;padding-left:14px;border-left:3px solid #7a1a2b}\n.hero .meta{position:absolute;top:0;right:22px;font-size:11px;letter-spacing:.3em;color:#7a1a2b;text-transform:uppercase;writing-mode:vertical-rl}\n@media (max-width:600px){.hero{padding:60px 20px 50px}.hero .meta{display:none}}\n\n/* 区块基础 */\nsection{padding:72px 22px;border-bottom:1px dashed rgba(122,26,43,.3)}\nsection:last-child{border-bottom:none}\n.sec-head{display:flex;align-items:baseline;gap:18px;margin-bottom:36px;flex-wrap:wrap}\n.sec-head .no{font-family:\"Optima\",\"PingFang SC\",sans-serif;font-size:13px;letter-spacing:.3em;color:#7a1a2b}\n.sec-head h2{font-size:30px;font-weight:700;color:#3a0d12;letter-spacing:.02em}\n.sec-head h2::after{content:\"\";display:block;width:36px;height:2px;background:#7a1a2b;margin-top:10px}\n.sec-head .sub{font-size:13px;color:#7a242c;letter-spacing:.1em;margin-left:auto;text-align:right;max-width:280px}\n\n/* 票据风格卡片 */\n.ticket{background:#fdf9f0;border:1px dashed #7a1a2b;padding:26px 28px 26px 36px;position:relative;margin-bottom:18px}\n.ticket::before{content:\"\";position:absolute;left:14px;top:14px;bottom:14px;width:2px;background:#7a1a2b}\n.ticket h3{font-size:19px;color:#3a0d12;margin-bottom:10px;display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}\n.ticket h3 .num{font-family:\"Optima\",sans-serif;font-size:12px;color:#7a1a2b;letter-spacing:.3em}\n.ticket .body{font-size:14.5px;color:#4a2429}\n.ticket ul{list-style:none;margin-top:10px}\n.ticket li{padding-left:18px;position:relative;font-size:14px;color:#5a242c;margin-bottom:6px}\n.ticket li::before{content:\"·\";position:absolute;left:4px;color:#7a1a2b;font-weight:700;font-size:18px;line-height:1}\n.ticket .row{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;border-top:1px dashed rgba(122,26,43,.35);padding-top:12px;margin-top:14px;font-size:12px;color:#7a1a2b;letter-spacing:.05em}\n\n/* 阶梯式套餐 */\n.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:0;position:relative}\n.plans .step{padding:36px 22px 30px;background:#fdf9f0;border:1px dashed #7a1a2b;text-align:center;position:relative}\n.plans .step:nth-child(1){transform:translateY(12px);background:#f7eedb;z-index:1}\n.plans .step:nth-child(2){transform:translateY(0);background:#fbf3e3;z-index:3;box-shadow:0 0 0 1px #7a1a2b;border-style:solid}\n.plans .step:nth-child(3){transform:translateY(24px);background:#f5e8d0;z-index:2}\n.plans .step .lvl{font-family:\"Optima\",sans-serif;font-size:11px;letter-spacing:.5em;color:#7a1a2b;text-transform:uppercase}\n.plans .step h3{font-size:22px;color:#3a0d12;margin:8px 0 6px}\n.plans .step .price{font-size:30px;font-weight:700;color:#3a0d12;line-height:1}\n.plans .step .price small{font-size:13px;color:#7a1a2b;font-weight:400}\n.plans .step .annual{font-size:12px;color:#7a242c;margin:6px 0 16px;letter-spacing:.05em}\n.plans .step ul{list-style:none;text-align:left;margin:14px 0 18px;font-size:13.5px;color:#4a2429}\n.plans .step ul li{padding:6px 0 6px 18px;border-bottom:1px dashed rgba(122,26,43,.25);position:relative}\n.plans .step ul li::before{content:\"✓\";position:absolute;left:0;color:#7a1a2b;font-size:12px}\n.plans .step .badge{position:absolute;top:-10px;left:50%;transform:translateX(-50%);background:#7a1a2b;color:#faf5ea;font-size:11px;letter-spacing:.2em;padding:3px 12px}\n@media (max-width:760px){.plans{grid-template-columns:1fr;gap:14px}.plans .step{transform:none!important;box-shadow:none!important;border-style:dashed!important}}\n\n/* 使用说明 */\n.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}\n.steps .step{background:#fdf9f0;border:1px dashed #7a1a2b;padding:22px 18px}\n.steps .step .n{font-family:\"Optima\",sans-serif;font-size:28px;color:#7a1a2b;font-weight:700;line-height:1}\n.steps .step h4{font-size:15px;color:#3a0d12;margin:8px 0 6px}\n.steps .step p{font-size:13px;color:#5a242c}\n@media (max-width:760px){.steps{grid-template-columns:repeat(2,1fr)}}\n\n/* FAQ 按主题分组 */\n.faq-group{margin-bottom:32px}\n.faq-group h3{font-size:18px;color:#3a0d12;border-left:4px solid #7a1a2b;padding-left:12px;margin-bottom:14px;letter-spacing:.03em}\n.faq-item{background:#fdf9f0;border:1px dashed #7a1a2b;padding:16px 22px;margin-bottom:10px}\n.faq-item .q{font-size:15px;color:#3a0d12;font-weight:600;margin-bottom:8px;display:flex;gap:10px}\n.faq-item .q::before{content:\"Q.\";color:#7a1a2b;font-family:\"Optima\",sans-serif}\n.faq-item .a{font-size:14px;color:#5a242c;padding-left:24px;position:relative}\n.faq-item .a::before{content:\"A.\";position:absolute;left:0;color:#7a1a2b;font-family:\"Optima\",sans-serif;font-weight:600}\n\n/* 原则清单 */\n.principles{list-style:none;display:grid;grid-template-columns:repeat(2,1fr);gap:14px}\n.principles li{background:#fdf9f0;border:1px dashed #7a1a2b;padding:18px 22px;font-size:14px;color:#4a2429}\n.principles li strong{color:#3a0d12;display:block;margin-bottom:6px;letter-spacing:.05em}\n@media (max-width:600px){.principles{grid-template-columns:1fr}}\n\n/* 页脚 */\nfooter{padding:40px 22px;background:#3a0d12;color:#f0e4d0;text-align:center;font-size:12.5px;letter-spacing:.1em}\nfooter .stamp{display:inline-block;border:1px solid #c89a8a;padding:6px 16px;letter-spacing:.5em;font-family:\"Optima\",sans-serif;font-size:11px;margin-bottom:12px;color:#f0e4d0}\n\nmain{display:block}\n</style><nav class=\"jumpnav\" aria-label=\"页面内跳转\">\n  <span class=\"dot\"></span>\n  <a href=\"#about\">关于</a>\n  <a href=\"#plans\">方案</a>\n  <a href=\"#use\">使用</a>\n  <a href=\"#clients\">客户端</a>\n  <a href=\"#faq\">答疑</a>\n  <span class=\"spacer\"></span>\n  <span>EST. CHAPTER ONE</span>\n</nav>\n\n<header class=\"hero\" role=\"banner\">\n  <div class=\"hero-inner\">\n    <div class=\"eyebrow\">A QUIET NETWORK NOTEBOOK · 第一章</div>\n    <h1>隐秘网络(SCRTNET) · 隐秘网络<small>SCRTNET</small></h1>\n    <p class=\"tagline\">把日常的连接，藏进安静的章节。我们用一张清单式的服务边界，替代那些被讲滥的承诺。三档方案，按月或按年付费，按需取用。</p>\n    <span class=\"meta\">VOL · 01 · SCRTNET</span>\n  </div>\n</header>\n\n<main>\n\n<section id=\"about\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">§ 01</span>\n      <h2>关于这本小册子</h2>\n      <p class=\"sub\">一份写给订阅者的说明，按清单逐条列出，没有夸张的形容词。</p>\n    </div>\n\n    <div class=\"ticket\">\n      <h3><span class=\"num\">NOTE 01</span> 我们在做的，是一份可被逐条核对的清单</h3>\n      <div class=\"body\">隐秘网络 SCRTNET 由一组编辑者维护。它不是“极速、稳定、全球加速”的口号集合，而是一张写明流量、设备数与节点池范围的订阅表。我们希望你在付款之前，就能在页面上读到全部要点。</div>\n    </div>\n\n    <div class=\"ticket\">\n      <h3><span class=\"num\">NOTE 02</span> 用票据格式来呈现条款</h3>\n      <div class=\"body\">页面中的卡片采用票据排版：左侧一条酒红色细线，右侧虚线描边，整体保留书写感。信息条按编号排列，便于收藏与回看。</div>\n    </div>\n\n    <div class=\"ticket\">\n      <h3><span class=\"num\">NOTE 03</span> 配色与节奏</h3>\n      <div class=\"body\">酒红 #7a1a2b 与象牙白 #faf5ea 构成主色调，配深棕正文。海报式首屏以大字号品牌名铺开，配合三档阶梯化的方案卡片。</div>\n      <div class=\"row\"><span>SIGN · SCRTNET STUDIO</span><span>REVISED · THIS EDITION</span></div>\n    </div>\n\n    <ul class=\"principles\">\n      <li><strong>一 · 少承诺</strong>未发生或未经验证的能力，我们不会写进页面。</li>\n      <li><strong>二 · 多告知</strong>每一档方案的流量、设备数与节点池范围都写在卡片里。</li>\n      <li><strong>三 · 留余地</strong>支持按月或按年续费，年付不再叠加优惠描述，仅标注实付总额。</li>\n      <li><strong>四 · 可回看</strong>所有条款以章节方式归档，便于日后对照。</li>\n    </ul>\n  </div>\n</section>\n\n<section id=\"plans\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">§ 02</span>\n      <h2>阶梯式方案</h2>\n      <p class=\"sub\">三档呈阶梯排列，中间一档为编辑推荐。</p>\n    </div>\n\n    <div class=\"plans\">\n      <div class=\"step\">\n        <div class=\"lvl\">Level · 01</div>\n        <h3>基础版</h3>\n        <div class=\"price\">¥15<small> /月</small></div>\n        <div class=\"annual\">按年付仅需 ¥150/年</div>\n        <ul>\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n      </div>\n      <div class=\"step\">\n        <div class=\"badge\">EDITOR CHOICE</div>\n        <div class=\"lvl\">Level · 02</div>\n        <h3>旗舰版</h3>\n        <div class=\"price\">¥35<small> /月</small></div>\n        <div class=\"annual\">按年付仅需 ¥350/年</div>\n        <ul>\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n      </div>\n      <div class=\"step\">\n        <div class=\"lvl\">Level · 03</div>\n        <h3>团队版</h3>\n        <div class=\"price\">¥85<small> /月</small></div>\n        <div class=\"annual\">按年付仅需 ¥850/年</div>\n        <ul>\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"ticket\">\n      <h3><span class=\"num\">BILL</span> 续费与退订说明</h3>\n      <div class=\"body\">按月订阅可随时取消下一周期扣款；按年订阅以 12 个月为计费单位，年内退订将按已使用月份折算剩余款项。本页所列价格为编辑当下记录，最终结算以订单页为准。</div>\n    </div>\n  </div>\n</section>\n\n<section id=\"use\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">§ 03</span>\n      <h2>使用说明</h2>\n      <p class=\"sub\">四个步骤，编号从 01 到 04。</p>\n    </div>\n\n    <ol class=\"steps\">\n      <li class=\"step\">\n        <div class=\"n\">01</div>\n        <h4>选择方案</h4>\n        <p>在阶梯卡片中选定基础版、旗舰版或团队版，确认月付或年付。</p>\n      </li>\n      <li class=\"step\">\n        <div class=\"n\">02</div>\n        <h4>完成支付</h4>\n        <p>付款成功后，订阅凭证与初始密钥会发至登记邮箱。</p>\n      </li>\n      <li class=\"step\">\n        <div class=\"n\">03</div>\n        <h4>导入客户端</h4>\n        <p>按设备类型下载对应客户端，将密钥按页面提示导入。</p>\n      </li>\n      <li class=\"step\">\n        <div class=\"n\">04</div>\n        <h4>选择节点</h4>\n        <p>在节点池列表中挑选区域，保存后即可建立连接。</p>\n      </li>\n    </ol>\n\n    <div class=\"ticket\">\n      <h3><span class=\"num\">CHECKLIST</span> 上线前自检清单</h3>\n      <div class=\"body\">确认订阅在有效期内、客户端版本与系统匹配、密钥复制无空格、节点所在区域与你需要的访问目标一致。若步骤卡住，可前往下方答疑区按主题查找。</div>\n    </div>\n  </div>\n</section>\n\n<section id=\"clients\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">§ 04</span>\n      <h2>支持客户端</h2>\n      <p class=\"sub\">以下列出的客户端为编辑整理的常见对照，未提供独立分发地址时，将由订单页内附带的下载说明取代。</p>\n    </div>\n\n    <div class=\"ticket\">\n      <h3><span class=\"num\">DESKTOP</span> 桌面端</h3>\n      <div class=\"body\">适用于 Windows、macOS、常见 Linux 发行版的桌面客户端。桌面客户端通常提供节点延迟可视化与多窗口切换，请以你拿到的版本说明为准。</div>\n      <ul>\n        <li>Windows · 64 位安装包</li>\n        <li>macOS · Apple Silicon 与 Intel 双版本</li>\n        <li>Linux · 提供主流发行版兼容脚本</li>\n      </ul>\n    </div>\n\n    <div class=\"ticket\">\n      <h3><span class=\"num\">MOBILE</span> 移动端</h3>\n      <div class=\"body\">适用于 Android 与 iOS 设备的客户端。移动端常驻通知与低电量模式可在系统设置中调整，密钥导入步骤与桌面端一致。</div>\n      <ul>\n        <li>Android · 原生安装包</li>\n        <li>iOS · 通过订单页内附带的安装说明获取</li>\n      </ul>\n    </div>\n\n    <div class=\"ticket\">\n      <h3><span class=\"num\">ROUTER</span> 路由端</h3>\n      <div class=\"body\">支持常见第三方路由固件的接入方式，适用于需要让整个局域网设备共享同一份订阅的家庭或工作室场景。路由端配置需自备硬件，请先确认固件兼容性。</div>\n      <ul>\n        <li>OpenWrt · 一键脚本</li>\n        <li>iKuaiOS · 手动导入订阅</li>\n        <li>梅林固件 · 通过 Web 后台添加</li>\n      </ul>\n    </div>\n  </div>\n</section>\n\n<section id=\"faq\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"no\">§ 05</span>\n      <h2>常见问题</h2>\n      <p class=\"sub\">按主题分组，便于按需阅读。</p>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>一、关于订阅与计费</h3>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">月付与年付之间有什么区别？</div>\n        <div class=\"a\">月付按自然月计费，可在下一周期扣款前取消；年付以 12 个月为计费单位，年内价格不变，年付总额已在套餐卡片中逐档列出。</div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">能否在到期前升级或降级方案？</div>\n        <div class=\"a\">支持在套餐有效期内变更，新方案将在下一计费周期生效。当前周期内已扣费用不会被重新分摊，差额也不会单独结算。</div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">年付中途退订如何处理？</div>\n        <div class=\"a\">按已使用月份折算金额退还剩余款项，折算基数为该档方案的月付价格。</div>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>二、关于连接与设备</h3>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">同时在线的设备数怎么计数？</div>\n        <div class=\"a\">按客户端实例计数，同一台设备重复登录会被视作两次占用。基础版 3 台、旗舰版 5 台、团队版 20 台。</div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">节点池的范围在哪里查看？</div>\n        <div class=\"a\">登录客户端后即可看到当前订阅对应的节点列表；具体可用区域会随线路维护情况动态调整。</div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">连接出现异常时应先排查什么？</div>\n        <div class=\"a\">建议按以下顺序排查：本地网络是否通畅、客户端是否为最新版本、密钥是否完整复制、节点是否处于维护状态；仍无法解决时可提交工单。</div>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>三、关于流量与功能</h3>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">每月流量会在何时重置？</div>\n        <div class=\"a\">按订阅起始日起算 30 天滚动重置，重置日的具体时间见订单页说明。</div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">流媒体解锁范围如何理解？</div>\n        <div class=\"a\">基础版仅解锁基础流媒体；旗舰版在全节点上提供原生流媒体解锁；团队版在此基础上提供高带宽节点的同类访问能力。</div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">IPLC 专线是什么？</div>\n        <div class=\"a\">IPLC 专线是面向游戏等对延迟敏感场景的专线通道，仅在旗舰版及以上方案中提供，作为节点池的一种补充。</div>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>四、关于支持与隐私</h3>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">工单支持的响应时间？</div>\n        <div class=\"a\">旗舰版及以上方案提供 7×24 优先工单支持；其余方案在工作时段内处理，建议在工单中写明订阅编号与复现步骤。</div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">订阅信息会保留多久？</div>\n        <div class=\"a\">订阅期满后，账号与密钥在 90 天内保留以便恢复；超过 90 天的账号将进入清理队列，最终只保留必要的财务对账记录。</div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"q\">团队版的客户经理负责哪些事项？</div>\n        <div class=\"a\">客户经理负责订阅协助、发票相关咨询以及企业定制路由的需求收集；不直接接触客户内部的运维数据。</div>\n      </div>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"stamp\">SCRTNET · QUIET CHAPTER</div>\n  <div>隐秘网络 SCRTNET ／ 按章节编辑，按清单交付 ／ 本页为品牌信息归档，不构成对外承诺</div>\n</footer>",
